# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# OpenAI (입력 분류, 아이디어 그루핑, 구매 메일 파싱)
# ──────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# 지도 & 이동시간 API
# ──────────────────────────────────────────────
KAKAO_REST_API_KEY=
ODSAY_API_KEY=

# ──────────────────────────────────────────────
# Naver API (장소 검색, 상품 검색)
# ──────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Google OAuth (Gmail 구매 메일 동기화)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Web Push (VAPID)
# ──────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# ──────────────────────────────────────────────
# iOS APNs 푸시
# ──────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_ENV=

# ──────────────────────────────────────────────
# Android Firebase Cloud Messaging (서비스 계정)
# ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ──────────────────────────────────────────────
# 보안 & 인증
# ──────────────────────────────────────────────
# 필수: 없거나 일치하지 않으면 모든 예약 실행 API가 401로 거부됩니다.
CRON_SECRET=

# 토큰 암호화 키 (AES-256-GCM)
# 64자리 16진수(32바이트)여야 합니다. 생성 명령어:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 주의: 이 키가 없으면 암호화/복호화가 실패하여 애플리케이션에 에러가 발생합니다.
# 키 회전 시 새 키를 여기에 두고, 직전 키는 TOKEN_ENCRYPTION_KEY_PREVIOUS에
# 잠시 보관하세요. 기존 토큰은 정상 사용 후 새 키로 점진 재암호화됩니다.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# (선택) 로컬 개발 환경에서 평문 토큰 저장을 허용하려면 true로 설정하세요.
# ALLOW_PLAINTEXT_TOKENS는 로컬 개발 또는 테스트 전용이며,
# 프로덕션(NODE_ENV=production)에서는 true로 설정해도 무시되고 평문 저장이 거부됩니다.
ALLOW_PLAINTEXT_TOKENS=

# ──────────────────────────────────────────────
# 앱 URL (선택, 기본값: https://my-secretary-remote.vercel.app)
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ──────────────────────────────────────────────
# 브리핑 봇용 읽기 전용 API (GET /api/briefing)
# ──────────────────────────────────────────────
# Authorization: Bearer 헤더로 비교하는 토큰. 생성: openssl rand -hex 32
# 값은 Vercel 환경변수에만 넣고 코드·문서·커밋에 남기지 마세요.
BRIEFING_API_TOKEN=
# 브리핑 대상 계정의 앱 로그인 아이디 (이 계정 데이터만 반환)
BRIEFING_LOGIN_ID=

# 선택: 로그인 연결 기록이 없는 기존 계정을 서버에서 확인한 고유 UUID로 지정
# 설정 시 해당 사용자 한 명만 조회하고 로그인 아이디/표시이름으로 대상을 확장하지 않음
BRIEFING_USER_ID=
